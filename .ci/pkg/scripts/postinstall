#!/bin/bash

set -o pipefail

# Resolve the actual logged-in user for per-user setup in pkg postinstall context.
HOME_USER=$(stat -f %Su /dev/console 2>/dev/null)
if [ -z "${HOME_USER}" ] || [ "${HOME_USER}" = "root" ] || [ "${HOME_USER}" = "loginwindow" ]; then
	HOME_USER=$(whoami)
fi

# caked and cakectl ship as separate helper apps in Caker.app/Contents/PlugIns
# (see CAKED_APP/CAKECTL_APP in Scripts/build.inc.sh).
CAKED_DIR="/Applications/Caker.app/Contents/PlugIns/caked.app/Contents/MacOS"
CAKECTL_DIR="/Applications/Caker.app/Contents/PlugIns/cakectl.app/Contents/MacOS"
CAKED="${CAKED_DIR}/caked"

HOME=$(dscl . -read "/Users/${HOME_USER}" NFSHomeDirectory 2>/dev/null | awk '{print $2}')
if [ -z "${HOME}" ]; then
	HOME="${HOME:-/var/root}"
fi

# Log file for installation
HOME_UID=$(stat -f %u "${HOME}" 2>/dev/null || id -u "${HOME_USER}" 2>/dev/null || echo "$(id -u)")
LOG_FILE="${HOME}/Library/Logs/Caker/caker-postinstall.log"

mkdir -p "${HOME}/Library/Logs/Caker"

# Group all commands and tee both stdout and stderr to log file
{
	set -e

	export CAKE_HOME="${HOME}/.cake"

    echo "=== Caker Post-Installation Started at $(date) ==="
    echo "Home directory: ${HOME}"
    echo "Home UID: ${HOME_UID}"
    echo "Home user: ${HOME_USER}"

    echo "Setting up PATH..."
    printf '%s\n%s\n' "${CAKED_DIR}" "${CAKECTL_DIR}" > /etc/paths.d/com.aldunelabs.caker

    echo "Creating sudoers file..."
    # Passwordless sudo for this one caked, for the installing user only, pinned by its SHA-256: sudo refuses the command if the
    # binary or the bundle is replaced afterwards. The digest changes with every release, so this runs on each install and upgrade
    # (the app also rewrites it at launch when it no longer matches, see SudoCaked.sudoersRule).
    SUDOERS_FILE="/etc/sudoers.d/caked-pinned"
    SUDOERS_TMP="/etc/sudoers.d/.caked-pinned.$$"
    CAKED_SHA256=$(/usr/bin/shasum -a 256 "${CAKED}" | awk '{print $1}')
    SUDO_UID=$(id -u "${HOME_USER}")

    # The old rule granted every user (%everyone) and was not pinned: never keep it.
    rm -f /etc/sudoers.d/caked

    printf '#%s ALL=(root:wheel) NOPASSWD:SETENV: sha256:%s %s\n' "${SUDO_UID}" "${CAKED_SHA256}" "${CAKED}" > "${SUDOERS_TMP}"
    chown root:wheel "${SUDOERS_TMP}"
    chmod 0440 "${SUDOERS_TMP}"

    # A broken sudoers file locks sudo out: only install one that visudo accepts.
    if /usr/sbin/visudo -c -f "${SUDOERS_TMP}" >/dev/null; then
        mv -f "${SUDOERS_TMP}" "${SUDOERS_FILE}"
    else
        rm -f "${SUDOERS_TMP}"
        echo "Invalid sudoers file, passwordless sudo for caked not installed"
    fi

    echo "Generating certificates..."
    # Install the Caker service with proper UID
    sudo -u "${HOME_USER}" "${CAKED}" certificates generate

    echo "Installing Caker service..."
    # Prompt for passphrase if not provided
    if [ -z "${PASSWORD}" ]; then
        echo "Prompting user for passphrase..."
        
        # Detect system language (check primary language preference)
        LANG_CODE=$(sudo -u "${HOME_USER}" defaults read NSGlobalDomain AppleLanguages 2>/dev/null | /usr/bin/grep -v -E '[\(\)]' | head -1 || echo "en")
        
        # Set appropriate message based on language
        if [[ "${LANG_CODE}" == *"fr"* ]]; then
            DIALOG_MESSAGE="Veuillez entrer une phrase secrète pour le service Caker:"
        else
            DIALOG_MESSAGE="Please enter a passphrase for the Caker service:"
        fi
        
        PASSWORD=$(sudo -u "${HOME_USER}" osascript -e "display dialog \"${DIALOG_MESSAGE}\" default answer \"\" with hidden answer" -e 'text returned of result' 2>/dev/null)
        if [ $? -ne 0 ] || [ -z "${PASSWORD}" ]; then
            echo "Passphrase prompt cancelled or empty, installing without passphrase..."
        fi
    fi
    
    # Install the Caker service with proper UID
    if [ -n "${PASSWORD}" ]; then
        sudo -S -u "${HOME_USER}" "${CAKED}" set local.passphrase="${PASSWORD}" 2>/dev/null || echo "Failed to set passphrase, proceeding without it..."
    fi

    sudo -u "${HOME_USER}" "${CAKED}" service install --tcp --rest || echo "Failed to install Caker service, please check the log for details."

    echo "=== Caker Post-Installation Completed at $(date) ==="
} 2>&1 | tee "${LOG_FILE}"
PIPELINE_STATUS=${PIPESTATUS[0]}

chown "${HOME_USER}:staff" "${LOG_FILE}"
exit "${PIPELINE_STATUS}"