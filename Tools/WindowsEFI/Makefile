# Builds framebuffer and loader for ARM64 and x64 and regenerates Sources/cakedlib/Windows/WindowsEFIBinaries.swift (the
# binaries are embedded as base64 so they need no bundle resources).
# Needs clang and lld-link (brew install llvm lld). The binaries are committed, so this only
# needs to run after changing the C sources.
LLD_LINK ?= lld-link
# make DEBUG=1 adds bring-up markers on screen (see Mark() in the sources)
ifdef DEBUG
CFLAGS += -DDEBUG_MARKS
endif
CFLAGS += -ffreestanding -fshort-wchar -fno-builtin -fno-stack-protector -mno-implicit-float -O2 -Wall -Wextra -Wno-unused-parameter

# clang's target triple for each guest architecture; x64 firmware calls with the Microsoft ABI, which is what a
# *-windows target uses, and runs interrupt-driven callbacks (the timer) on the interrupted stack: no red zone.
TARGET_arm64 = aarch64-unknown-windows
TARGET_amd64 = x86_64-unknown-windows
CFLAGS_arm64 =
CFLAGS_amd64 = -mno-red-zone

ARCHS = arm64 amd64
BINARIES = $(foreach arch,$(ARCHS),framebuffer-$(arch).efi loader-$(arch).efi)

OUTPUT = ../../Sources/cakedlib/Windows/WindowsEFIBinaries.swift

all: $(OUTPUT)

# $(call constant,Swift name,doc comment,file)
define constant
	@echo '\t/// $(2)' >> $@
	@printf '\tstatic let $(1) = Data(base64Encoded: "%s")!\n' "$$(openssl base64 -A -in $(3))" >> $@
	@echo '' >> $@
endef

$(OUTPUT): $(BINARIES) Makefile
	@echo '// Generated by Tools/WindowsEFI/Makefile, do not edit.' > $@
	@echo '' >> $@
	@echo 'import Foundation' >> $@
	@echo '' >> $@
	@echo '/// The EFI helpers the Windows installation media carries, one build per guest architecture (a PE image runs on'  >> $@
	@echo '/// firmware of its own machine type only).' >> $@
	@echo 'enum WindowsEFIBinaries {' >> $@
	$(call constant,framebufferARM64,UEFI boot service driver giving Windows a linear framebuffer (framebuffer.c - AArch64).,framebuffer-arm64.efi)
	$(call constant,loaderARM64,UEFI application that starts the driver and then Windows Boot Manager (loader.c - AArch64).,loader-arm64.efi)
	$(call constant,framebufferAMD64,UEFI boot service driver giving Windows a linear framebuffer (framebuffer.c - x64).,framebuffer-amd64.efi)
	$(call constant,loaderAMD64,UEFI application that starts the driver and then Windows Boot Manager (loader.c - x64).,loader-amd64.efi)
	@echo '\tstatic func framebuffer(for architecture: WindowsArchitecture) -> Data {' >> $@
	@echo '\t\tswitch architecture {' >> $@
	@echo '\t\tcase .arm64: return framebufferARM64' >> $@
	@echo '\t\tcase .amd64: return framebufferAMD64' >> $@
	@echo '\t\t}' >> $@
	@echo '\t}' >> $@
	@echo '' >> $@
	@echo '\tstatic func loader(for architecture: WindowsArchitecture) -> Data {' >> $@
	@echo '\t\tswitch architecture {' >> $@
	@echo '\t\tcase .arm64: return loaderARM64' >> $@
	@echo '\t\tcase .amd64: return loaderAMD64' >> $@
	@echo '\t\t}' >> $@
	@echo '\t}' >> $@
	@echo '}' >> $@

binaries: $(BINARIES)

# framebuffer-<arch>.efi, loader-<arch>.efi
define build
$(1)-$(2).o: $(1).c efi.h
	clang -target $$(TARGET_$(2)) $$(CFLAGS) $$(CFLAGS_$(2)) -c $$< -o $$@

$(1)-$(2).efi: $(1)-$(2).o
	$$(LLD_LINK) /nologo /Brepro /nodefaultlib /dll /entry:efi_main /subsystem:$$(SUBSYSTEM_$(1)) /out:$$@ $$<
endef

SUBSYSTEM_framebuffer = efi_boot_service_driver
SUBSYSTEM_loader = efi_application

$(foreach arch,$(ARCHS),$(foreach program,framebuffer loader,$(eval $(call build,$(program),$(arch)))))

clean:
	rm -f *.efi *.o *.lib

.PHONY: all binaries clean
