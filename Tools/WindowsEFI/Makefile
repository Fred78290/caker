# Builds framebuffer.efi and loader.efi and regenerates Sources/cakedlib/Windows/WindowsEFIBinaries.swift (the binaries are embedded
# as base64 so they need no bundle resources).
# Needs clang and lld-link (brew install llvm lld). The binaries are committed, so this only
# needs to run after changing the C sources.
LLD_LINK ?= lld-link
# make DEBUG=1 adds bring-up markers on screen (see Mark() in the sources)
ifdef DEBUG
CFLAGS += -DDEBUG_MARKS
endif
CFLAGS += -target aarch64-unknown-windows -ffreestanding -fshort-wchar -fno-builtin -fno-stack-protector \
	-mno-implicit-float -O2 -Wall -Wextra -Wno-unused-parameter

OUTPUT = ../../Sources/cakedlib/Windows/WindowsEFIBinaries.swift

all: $(OUTPUT)

$(OUTPUT): framebuffer.efi loader.efi Makefile
	@echo '// Generated by Tools/WindowsEFI/Makefile, do not edit.' > $@
	@echo '' >> $@
	@echo 'import Foundation' >> $@
	@echo '' >> $@
	@echo 'enum WindowsEFIBinaries {' >> $@
	@echo '\t/// UEFI boot service driver giving Windows a linear framebuffer (framebuffer.c).' >> $@
	@printf '\tstatic let framebuffer = Data(base64Encoded: "%s")!\n' "$$(openssl base64 -A -in framebuffer.efi)" >> $@
	@echo '' >> $@
	@echo '\t/// UEFI application that starts the driver, then Windows Boot Manager (loader.c).' >> $@
	@printf '\tstatic let loader = Data(base64Encoded: "%s")!\n' "$$(openssl base64 -A -in loader.efi)" >> $@
	@echo '}' >> $@

binaries: framebuffer.efi loader.efi

%.efi: %.c efi.h
	clang $(CFLAGS) -c $< -o $*.o
	$(LLD_LINK) /nologo /Brepro /nodefaultlib /dll /entry:efi_main /subsystem:$(SUBSYSTEM) /out:$@ $*.o
	rm -f $*.o $*.lib

framebuffer.efi: SUBSYSTEM = efi_boot_service_driver
loader.efi: SUBSYSTEM = efi_application

clean:
	rm -f *.efi *.o *.lib

.PHONY: all clean
