# systemd user unit: starts the seamless windows compositor at login.
# Install: cp caker-seamlessd.service ~/.config/systemd/user/ && systemctl --user enable --now caker-seamlessd
# Apps then use it with: WAYLAND_DISPLAY=caker-seamless <app>
[Unit]
Description=Caker seamless windows compositor

[Service]
ExecStart=/usr/local/bin/caker-seamlessd --socket caker-seamless
Restart=on-failure
RestartSec=2

[Install]
WantedBy=default.target
