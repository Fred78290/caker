{
	"files.exclude": {
		"**/.build": true,
		"**/.appstore": true,
		"**/.release": true,
		"**/.debug": true,
		"DerivedData": true,
		".swiftpm": true,
		"actions-runner": true,
		"**/node_modules": true,
		"**/Pods": true,
		"**/vendor": true,
		".ci/dmg": true,
	},
	"python.testing.pytestArgs": [
		"integration/tests",
	],
	"python.testing.unittestEnabled": false,
	"python.testing.pytestEnabled": true,
	"java.compile.nullAnalysis.mode": "disabled",
	"js/ts.experimental.useTsgo": false,
	"swift.additionalTestArguments": [
		"-Xswiftc",
		"-D",
		"-Xswiftc",
		"SPARKLE",
		"-Xswiftc",
		"-D",
		"-Xswiftc",
		"USE_VIRTUAL_INSTALL_BACKEND"
	],
}